# Copy this file to deploy/.env on the EC2 instance and fill in the values.
# Keep deploy/.env private; it contains runtime secrets.

# -----------------------------------------------------------------------------
# EC2 / public entrypoint
# -----------------------------------------------------------------------------
# Optional. If empty, scripts try EC2 metadata first, then checkip.amazonaws.com.
EC2_PUBLIC_IP=

# Public HTTP port exposed by the nginx service.
NGINX_PORT=80

# The production frontend defaults API calls to the same origin, so this should
# usually stay empty. Set only if the browser should call a different backend.
VITE_BACKEND_BASE_URL=

# Browser WebRTC handshake settings for OpenAI Realtime.
VITE_OPENAI_REALTIME_WEBRTC_HANDSHAKE=calls
VITE_OPENAI_REALTIME_HTTP_BASE=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Core backend
# -----------------------------------------------------------------------------
PROJECT_NAME=rag_chatbot_backend
API_V1_PREFIX=/api/v1
MONGODB_DB_NAME=rag_chatbot_backend

# Leave blank to generate/reuse backend/.env JWT_SECRET_KEY.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Override only if you need a custom browser origin list. When blank, the deploy
# script generates ["http://<EC2_PUBLIC_IP>", "http://localhost", "http://127.0.0.1"].
BACKEND_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# OpenAI-compatible chat, embeddings, and Realtime
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_REQUEST_TIMEOUT_SECONDS=60
OPENAI_REALTIME_MINT_MAX_RETRIES=2
OPENAI_REALTIME_MINT_BACKOFF_BASE_SECONDS=0.25
OPENAI_REALTIME_MINT_LIMIT_PER_USER=20
OPENAI_REALTIME_MINT_LIMIT_WINDOW_SECONDS=60
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=inf
OPENAI_REALTIME_VAD_THRESHOLD=0.78
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=350
OPENAI_REALTIME_VAD_SILENCE_MS=650

LLM_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_MESSAGES=40
CHAT_ROUTER_MODEL=gpt-4o-mini
CHAT_RESPONDER_MODEL=gpt-4o-mini
CHAT_HISTORY_FETCH_LIMIT=20
CHAT_ROUTER_MAX_MESSAGES=20
CHAT_RAG_TOP_K=5
CHAT_RAG_MIN_SCORE=0.25
CHAT_RAG_VOICE_TOP_K=3
CHAT_RAG_VOICE_EXCERPT_CHARS=1500
CHAT_RESPONDER_TEMPERATURE=0.2
CHAT_SESSION_TITLE_MODEL=gpt-4o-mini
CHAT_SESSION_TITLE_MAX_TOKENS=64
CHAT_SESSION_TITLE_TEMPERATURE=0.2
CHAT_SESSION_TITLE_PROMPT_MAX_CHARS=4000

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSION=1536

# -----------------------------------------------------------------------------
# Qdrant, storage, documents, and website crawling
# -----------------------------------------------------------------------------
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_CHUNK_STRATEGY=auto
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
WEBSITE_CRAWL_TIMEOUT_SECONDS=20
WEBSITE_MAX_HTML_BYTES=2000000

ZIP_SESSION_TTL_HOURS=24
ZIP_INGEST_PATH_BATCH_DEFAULT=50
ZIP_INGEST_MAX_PATH_BATCH=500
ZIP_INGEST_MAX_PATH_INDICES=500
ZIP_INGEST_MAX_MARKDOWN_LISTED=100000
ZIP_INGEST_MAX_UNCOMPRESSED_BYTES=52428800
ZIP_INGEST_MAX_ENTRY_BYTES=8388608

# -----------------------------------------------------------------------------
# Optional seed document ingestion
# -----------------------------------------------------------------------------
# Set DOCS_ZIP to a repo-relative or absolute .zip path.
# Example: DOCS_ZIP=deploy/seed/dds_knowledge_base_full.zip
DOCS_ZIP=

# This is an app login identity for the authenticated ingestion API. It is not
# an email delivery service and does not need a real inbox.
INGEST_EMAIL=
INGEST_PASSWORD=
INGEST_REGISTER=true
FORCE_INGEST=false
