# Copy this file to deploy/.env on the EC2 instance and fill in the values.
# Keep deploy/.env private; it contains runtime secrets.

# Optional. If empty, scripts try EC2 metadata first, then checkip.amazonaws.com.
EC2_PUBLIC_IP=

# Public HTTP port exposed by the nginx service.
NGINX_PORT=80

# Required for chat, embeddings, and document ingestion.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL=gpt-4o-mini

# Optional. Leave blank to generate/reuse backend/.env JWT_SECRET_KEY.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend runtime defaults.
PROJECT_NAME=rag_chatbot_backend
MONGODB_DB_NAME=rag_chatbot_backend
QDRANT_COLLECTION_NAME=rag_documents
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_CHUNK_STRATEGY=auto
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# Optional seed ingestion. Set DOCS_ZIP to a repo-relative or absolute .zip path.
# Example: DOCS_ZIP=deploy/seed/dds_knowledge_base_full.zip
DOCS_ZIP=
INGEST_EMAIL=
INGEST_PASSWORD=
INGEST_REGISTER=true
FORCE_INGEST=false
