# Backend API (browser calls this URL directly).
# Default when unset in dev: http://localhost:8000
VITE_BACKEND_BASE_URL=http://localhost:8000

# If your API does not send CORS headers for http://localhost:5173, use the Vite proxy instead:
# VITE_BACKEND_BASE_URL=/api

# OpenAI Realtime WebRTC handshake endpoint.
# - omit / `calls` → POST https://api.openai.com/v1/realtime/calls  (GA default)
# - `realtime`    → POST https://api.openai.com/v1/realtime?model=…  (legacy opt-in)
VITE_OPENAI_REALTIME_WEBRTC_HANDSHAKE=calls

# Optional: override the OpenAI Realtime HTTP origin (e.g. compatible proxy). Default:
# VITE_OPENAI_REALTIME_HTTP_BASE=https://api.openai.com/v1
