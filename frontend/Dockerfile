FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_BACKEND_BASE_URL=
ARG VITE_OPENAI_REALTIME_WEBRTC_HANDSHAKE=calls
ARG VITE_OPENAI_REALTIME_HTTP_BASE=https://api.openai.com/v1

ENV VITE_BACKEND_BASE_URL=$VITE_BACKEND_BASE_URL \
    VITE_OPENAI_REALTIME_WEBRTC_HANDSHAKE=$VITE_OPENAI_REALTIME_WEBRTC_HANDSHAKE \
    VITE_OPENAI_REALTIME_HTTP_BASE=$VITE_OPENAI_REALTIME_HTTP_BASE

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
