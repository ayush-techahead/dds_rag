PROJECT_NAME=rag_chatbot_backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=rag_chatbot_backend
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Browsers send an exact Origin string; list every scheme/host/port your frontend uses.
# Example: if the UI is opened as http://127.0.0.1:3000, include that (not only localhost).
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://localhost:5173"]
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_documents
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
EMBEDDING_DIMENSION=1536
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_CHUNK_STRATEGY=auto
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
WEBSITE_CRAWL_TIMEOUT_SECONDS=20
WEBSITE_MAX_HTML_BYTES=2000000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Voice: OpenAI Realtime client-secret mint (often stays on api.openai.com even if LLM uses another base).
OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_REQUEST_TIMEOUT_SECONDS=60
# Retry transient OpenAI errors (502/503/504, network failures) before failing the
# request. Total = 1 + OPENAI_REALTIME_MINT_MAX_RETRIES attempts.
OPENAI_REALTIME_MINT_MAX_RETRIES=2
OPENAI_REALTIME_MINT_BACKOFF_BASE_SECONDS=0.25
# Soft per-user mint rate limit; 0 disables. Driven by the realtime_session_events
# audit collection so it survives restarts.
OPENAI_REALTIME_MINT_LIMIT_PER_USER=20
OPENAI_REALTIME_MINT_LIMIT_WINDOW_SECONDS=60
# "inf" lets the model finish long answers without silent truncation (default OpenAI cap
# can cut audio mid-sentence on verbose tool-grounded responses). Accepts an int (1..4096)
# or the literal string "inf".
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=inf
# Historical server-VAD defaults. Minted Realtime sessions pin non-interrupting
# VAD in code: server_vad, interrupt_response=false, threshold=0.78,
# prefix_padding_ms=350, silence_duration_ms=650.
OPENAI_REALTIME_VAD_THRESHOLD=0.78
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=350
OPENAI_REALTIME_VAD_SILENCE_MS=650
LLM_MODEL=gpt-4o-mini
CHAT_RAG_TOP_K=5
CHAT_RAG_MIN_SCORE=0.25
# Voice path uses a tighter RAG budget so Realtime responses don't truncate.
CHAT_RAG_VOICE_TOP_K=3
CHAT_RAG_VOICE_EXCERPT_CHARS=1500
# Optional: unset to use provider default. Lower = more deterministic answers.
CHAT_RESPONDER_TEMPERATURE=0.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_TIMEOUT_SECONDS=120
ZIP_SESSION_TTL_HOURS=24
ZIP_INGEST_PATH_BATCH_DEFAULT=50
ZIP_INGEST_MAX_PATH_BATCH=500
ZIP_INGEST_MAX_PATH_INDICES=500
ZIP_INGEST_MAX_MARKDOWN_LISTED=100000
ZIP_INGEST_MAX_UNCOMPRESSED_BYTES=52428800
ZIP_INGEST_MAX_ENTRY_BYTES=8388608
